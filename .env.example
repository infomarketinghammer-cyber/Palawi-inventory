# MongoDB (Atlas or self-hosted replica set; Prisma needs a replica set for transactions).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/"
MONGODB_DB="palawi-inventory"
# Prisma connection string = MONGODB_URI + database name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/palawi-inventory?retryWrites=true&w=majority"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Initial users created by `npm run db:seed` (change the passwords after first login).
SEED_ADMIN_EMAIL="admin@palawi.org"
SEED_ADMIN_PHONE="9000000001"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_STORE_EMAIL="store@palawi.org"
SEED_STORE_PHONE="9000000002"
SEED_STORE_PASSWORD="ChangeMe@123"